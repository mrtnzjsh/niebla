package views

import (
	"fmt"
	"citc-toolchain/internal/db"
)

templ ReplyButton(clID int64, draftCount int) {
	<button
		type="button"
		id="cl-reply-btn"
		onclick="const modal = document.getElementById('reply-modal'); if (modal) { modal.showModal(); }"
		class={ "px-3 py-1.5 rounded-lg text-xs font-semibold shadow-md transition flex items-center space-x-2 border",
			templ.KV("bg-amber-600 hover:bg-amber-500 text-white border-amber-500/80 shadow-amber-600/30", draftCount > 0),
			templ.KV("bg-slate-800 hover:bg-slate-700 text-slate-200 border-slate-700 shadow-slate-900/40", draftCount == 0) }
		title="Review pending drafts, write overall comments, and post review verdicts"
	>
		<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
		</svg>
		<span>Reply</span>
		if draftCount > 0 {
			<span class="inline-flex items-center justify-center px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold bg-amber-950 text-amber-200 border border-amber-400/50">
				{ fmt.Sprintf("%d", draftCount) }
			</span>
		}
	</button>
}

templ ReplyModal(clID int64, activeReviewer string, draftCount int, drafts []db.Comment) {
	<dialog
		id="reply-modal"
		class="backdrop:bg-black/75 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto rounded-2xl shadow-2xl border border-slate-700 max-w-2xl w-full text-slate-200 overflow-hidden"
	>
		<div class="bg-[#0f172a] rounded-2xl border border-slate-700/60 overflow-hidden flex flex-col max-h-[90vh]">
			<!-- Modal Header -->
			<div class="px-6 py-4 bg-[#0c1322] border-b border-slate-800 flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<div class="w-8 h-8 rounded-lg bg-sky-600/30 border border-sky-500/40 flex items-center justify-center text-sky-400 font-bold">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
						</svg>
					</div>
					<div>
						<h3 class="text-sm font-bold text-white font-mono">{ fmt.Sprintf("Reply to CL %d", clID) }</h3>
						<p class="text-xs text-slate-400">Post your draft comments, summary notes, and review verdict</p>
					</div>
				</div>
				<button
					type="button"
					onclick="document.getElementById('reply-modal').close()"
					class="text-slate-400 hover:text-slate-100 p-1.5 rounded-lg hover:bg-slate-800 transition text-sm leading-none"
					title="Close dialog"
				>
					✕
				</button>
			</div>

			<!-- Form Container -->
			<form
				action={ templ.SafeURL(fmt.Sprintf("/cl/%d/reply", clID)) }
				method="POST"
				class="p-6 space-y-5 overflow-y-auto"
			>
				<input type="hidden" name="author" value={ activeReviewer }/>

				<!-- Draft Comments Section -->
				<div class="space-y-2">
					<div class="flex items-center justify-between text-xs font-semibold">
						<span class="text-slate-300 font-mono flex items-center space-x-1.5">
							<span>Draft Comments</span>
							if draftCount > 0 {
								<span class="px-1.5 py-0.2 rounded-full text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/40">
									{ fmt.Sprintf("%d pending", draftCount) }
								</span>
							}
						</span>
						if draftCount == 0 {
							<span class="text-slate-500 font-normal italic">None</span>
						}
					</div>

					if len(drafts) > 0 {
						<div class="space-y-2 max-h-48 overflow-y-auto pr-1">
							for _, d := range drafts {
								<div class="p-3 bg-slate-900/90 border border-amber-900/40 rounded-lg text-xs space-y-1 relative group">
									<div class="flex items-center justify-between">
										<span class="font-mono text-[11px] text-sky-400 font-medium">
											{ fmt.Sprintf("%s : %s (%s)", d.FilePath, d.LineRangeStr(), d.Side) }
										</span>
										<span class="px-1.5 py-0.2 rounded text-[10px] font-mono bg-amber-950 text-amber-300 border border-amber-800/40 font-semibold">
											draft
										</span>
									</div>
									<p class="text-slate-300 whitespace-pre-wrap font-sans text-xs">
										{ d.Body }
									</p>
								</div>
							}
						</div>
					} else {
						<div class="p-3 rounded-lg bg-slate-900/50 border border-slate-800 text-xs text-slate-400 italic">
							No unposted inline drafts on this CL. You can still post an overall review summary or update your verdict below.
						</div>
					}
				</div>

				<!-- Overall Review Summary Textarea -->
				<div class="space-y-1.5">
					<label class="block text-xs font-semibold text-slate-300">
						Overall Summary / Message (Optional)
					</label>
					<textarea
						name="message"
						rows="3"
						placeholder="Add overall review feedback, summary of changes, or next steps..."
						class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 font-sans transition resize-y"
					></textarea>
				</div>

				<!-- Review Verdict Selector -->
				<div class="space-y-2">
					<label class="block text-xs font-semibold text-slate-300">
						Review Verdict
					</label>
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
						<label class="flex items-center space-x-2 p-2.5 rounded-lg border border-slate-700/80 bg-slate-900/60 hover:bg-slate-800/60 cursor-pointer transition select-none">
							<input
								type="radio"
								name="verdict"
								value="lgtm"
								class="text-emerald-500 focus:ring-emerald-500 focus:ring-offset-0 bg-slate-950 border-slate-700"
							/>
							<div class="flex flex-col">
								<span class="font-semibold text-emerald-400">✓ LGTM / Approve</span>
								<span class="text-[10px] text-slate-400">Looks good to submit</span>
							</div>
						</label>

						<label class="flex items-center space-x-2 p-2.5 rounded-lg border border-slate-700/80 bg-slate-900/60 hover:bg-slate-800/60 cursor-pointer transition select-none">
							<input
								type="radio"
								name="verdict"
								value="changes_requested"
								class="text-rose-500 focus:ring-rose-500 focus:ring-offset-0 bg-slate-950 border-slate-700"
							/>
							<div class="flex flex-col">
								<span class="font-semibold text-rose-400">! Request Changes</span>
								<span class="text-[10px] text-slate-400">Needs revisions before submit</span>
							</div>
						</label>

						<label class="flex items-center space-x-2 p-2.5 rounded-lg border border-slate-700/80 bg-slate-900/60 hover:bg-slate-800/60 cursor-pointer transition select-none">
							<input
								type="radio"
								name="verdict"
								value="none"
								checked
								class="text-sky-500 focus:ring-sky-500 focus:ring-offset-0 bg-slate-950 border-slate-700"
							/>
							<div class="flex flex-col">
								<span class="font-semibold text-slate-300">Comment Only</span>
								<span class="text-[10px] text-slate-400">No verdict change</span>
							</div>
						</label>
					</div>
				</div>

				<!-- Modal Actions Footer -->
				<div class="pt-3 border-t border-slate-800 flex items-center justify-between">
					<div class="text-xs text-slate-400 font-mono">
						Reviewer: <span class="text-slate-200 font-semibold">{ activeReviewer }</span>
					</div>
					<div class="flex items-center space-x-2.5">
						<button
							type="button"
							onclick="document.getElementById('reply-modal').close()"
							class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition"
						>
							Cancel
						</button>
						<button
							type="submit"
							class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-sky-600 hover:bg-sky-500 text-white shadow-md shadow-sky-600/30 transition flex items-center space-x-1.5"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
							</svg>
							if draftCount > 0 {
								<span>{ fmt.Sprintf("Post Comments (%d)", draftCount) }</span>
							} else {
								<span>Post Comments</span>
							}
						</button>
					</div>
				</div>
			</form>
		</div>
	</dialog>
}
