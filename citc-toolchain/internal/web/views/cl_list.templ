package views

import (
	"fmt"
	"citc-toolchain/internal/db"
)

templ CLList(cls []db.Changelist) {
	@Layout("Changelists - Critique") {
		<div class="flex-1 max-w-6xl w-full mx-auto px-6 py-8">
			<!-- Header -->
			<div class="flex items-center justify-between pb-6 border-b border-slate-800">
				<div>
					<h1 class="text-2xl font-bold text-white tracking-tight">Active Changelists</h1>
					<p class="text-xs text-slate-400 mt-1">Review pending, shelved, and submitted CLs in CitC.</p>
				</div>
				<div class="text-xs text-slate-500 font-mono">
					{ fmt.Sprintf("%d total CL%s", len(cls), pluralS(len(cls))) }
				</div>
			</div>

			<!-- Table -->
			<div class="mt-6 rounded-xl border border-slate-800 bg-[#0d1424] overflow-hidden shadow-xl">
				<table class="w-full text-left font-sans text-xs">
					<thead class="bg-slate-900/90 text-slate-400 border-b border-slate-800 uppercase text-[11px] font-mono">
						<tr>
							<th class="w-24 px-4 py-3">CL ID</th>
							<th class="px-4 py-3">Description</th>
							<th class="w-36 px-4 py-3">Author</th>
							<th class="w-28 px-4 py-3 text-center">Status</th>
							<th class="w-40 px-4 py-3 text-right">Committed</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-800/60 font-mono text-xs">
						for _, cl := range cls {
							<tr class="hover:bg-slate-800/50 transition">
								<td class="px-4 py-3 font-bold">
									<a href={ templ.SafeURL(fmt.Sprintf("/cl/%d", cl.CLID)) } class="text-sky-400 hover:text-sky-300">
										{ fmt.Sprintf("CL %d", cl.CLID) }
									</a>
								</td>
								<td class="px-4 py-3 font-sans font-medium text-slate-200">
									<a href={ templ.SafeURL(fmt.Sprintf("/cl/%d", cl.CLID)) } class="hover:text-sky-400 transition line-clamp-1">
										{ cl.Description }
									</a>
								</td>
								<td class="px-4 py-3 text-slate-400">
									{ cl.Author }
								</td>
								<td class="px-4 py-3 text-center">
									switch cl.Status {
										case "submitted":
											<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-sky-950 text-sky-400 border border-sky-800">
												Submitted
											</span>
										case "shelved":
											<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-indigo-950 text-indigo-400 border border-indigo-800">
												Shelved
											</span>
										default:
											<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-950 text-amber-400 border border-amber-800">
												Pending
											</span>
									}
								</td>
								<td class="px-4 py-3 text-right text-slate-500 text-[11px]">
									{ cl.CommittedAt.Format("Jan 02, 15:04") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
