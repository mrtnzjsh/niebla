package views

import (
	"fmt"
	"strconv"
	"strings"
	"citc-toolchain/internal/db"
	"citc-toolchain/internal/web/diff"
)

// CLDetailData contains all context needed to render a changelist review page.
type CLDetailData struct {
	CL                 *db.Changelist
	Patchsets          []db.Patchset
	CurrentPatchset    int
	BasePatchset       int
	Files              []diff.FileDiffSummary
	SelectedFilePath   string
	SelectedFileDiff   *diff.FileDiffDetail
	CommentsByLine     map[int][]db.Comment
	Approvals          []db.Approval
	UnresolvedComments int
	ActiveReviewer     string
	ReviewedFilesCount int
	DraftCommentsCount int
	DraftComments      []db.Comment
}

templ CLDetail(data CLDetailData) {
	@Layout(fmt.Sprintf("CL %d: %s", data.CL.CLID, data.CL.Description)) {
		<div class="flex-1 flex flex-col bg-[#090d16]">
			<!-- CL Header Overview -->
			<div class="border-b border-slate-800 bg-[#0c1322] px-6 py-4 shadow-sm">
				<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
					<!-- CL Identity and Status -->
					<div class="flex flex-col space-y-1.5">
						<div class="flex items-center space-x-3">
							<span class="text-xl font-bold tracking-tight text-white font-mono">
								{ fmt.Sprintf("CL %d", data.CL.CLID) }
							</span>
							<div id="cl-status-badge">
								@StatusBadge(data.CL.Status, isCLApproved(data.Approvals))
							</div>
							<span class="text-xs text-slate-400 font-mono">
								{ fmt.Sprintf("by %s", data.CL.Author) }
							</span>
							<span class="text-slate-600">•</span>
							<span class="text-xs text-slate-500 font-mono">
								{ data.CL.CommittedAt.Format("Jan 02, 2006 15:04 MST") }
							</span>
						</div>
						<!-- Description -->
						<div class="text-sm text-slate-300 font-sans max-w-3xl whitespace-pre-wrap leading-relaxed">
							{ data.CL.Description }
						</div>
					</div>

					<!-- Reviewer Approvals & Actions -->
					<div class="flex flex-col items-start lg:items-end space-y-2">
						<div id="approvals-control" class="flex items-center space-x-2">
							<div id="cl-reply-btn-container">
								@ReplyButton(data.CL.CLID, data.DraftCommentsCount)
							</div>
							@ApprovalButtons(data.CL.CLID, data.Approvals)
						</div>
						<!-- Reviewers Summary List -->
						<div class="flex items-center space-x-2 text-xs text-slate-400">
							<span class="text-slate-500">Reviewers:</span>
							if len(data.Approvals) == 0 {
								<span class="italic text-slate-600">No review verdicts yet</span>
							} else {
								for _, a := range data.Approvals {
									<span class={ "inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-mono", getVerdictClass(a.Verdict) }>
										if a.Verdict == "lgtm" || a.Verdict == "approved" {
											<span>✓</span>
										} else {
											<span>!</span>
										}
										<span class="font-semibold">{ a.Reviewer }</span>
										<span class="opacity-80">({ a.Verdict })</span>
									</span>
								}
							}
						</div>
					</div>
				</div>

				<!-- Patchset Selector & Unresolved Summary Bar -->
				<div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
					<!-- Patchset Selector Dropdown -->
					<div class="flex items-center space-x-2">
						<span class="text-slate-400 font-medium">Patchset:</span>
						<div class="relative inline-block">
							<select
								id="patchset-selector"
								class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs font-mono text-slate-200 focus:outline-none focus:border-sky-500 cursor-pointer"
								onchange={ templ.ComponentScript{Call: fmt.Sprintf("window.location.href = '/cl/%d?ps=' + this.value.split(':')[0] + '&base_ps=' + this.value.split(':')[1];", data.CL.CLID)} }
							>
								for _, ps := range data.Patchsets {
									<option
										value={ fmt.Sprintf("%d:0", ps.PatchsetNumber) }
										selected?={ ps.PatchsetNumber == data.CurrentPatchset && data.BasePatchset == 0 }
									>
										{ fmt.Sprintf("Patchset %d vs Base CL", ps.PatchsetNumber) }
									</option>
								}
								<!-- Inter-patchset comparisons if multiple patchsets exist -->
								if len(data.Patchsets) > 1 {
									for i := 1; i < len(data.Patchsets); i++ {
										for j := 0; j < i; j++ {
											<option
												value={ fmt.Sprintf("%d:%d", data.Patchsets[i].PatchsetNumber, data.Patchsets[j].PatchsetNumber) }
												selected?={ data.Patchsets[i].PatchsetNumber == data.CurrentPatchset && data.Patchsets[j].PatchsetNumber == data.BasePatchset }
											>
												{ fmt.Sprintf("Patchset %d vs Patchset %d (inter-diff)", data.Patchsets[i].PatchsetNumber, data.Patchsets[j].PatchsetNumber) }
											</option>
										}
									}
								}
							</select>
						</div>
						<span class="text-slate-600 font-mono text-[11px]">
							{ fmt.Sprintf("(%d patchset%s available)", len(data.Patchsets), pluralS(len(data.Patchsets))) }
						</span>
					</div>

					<!-- Comments Summary Count -->
					<div class="flex items-center space-x-2">
						if data.UnresolvedComments > 0 {
							<span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-950/60 text-amber-300 border border-amber-800/50">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
								<span>{ fmt.Sprintf("%d Unresolved Comment%s", data.UnresolvedComments, pluralS(data.UnresolvedComments)) }</span>
							</span>
						} else {
							<span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-md text-xs font-medium bg-emerald-950/40 text-emerald-400 border border-emerald-900/40">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								<span>All comments resolved</span>
							</span>
						}
					</div>
				</div>
			</div>

			<!-- Changed Files Table -->
			<div class="bg-[#0b101d] border-b border-slate-800 px-6 py-3">
				<div class="flex items-center justify-between mb-2">
					<div class="flex items-center space-x-2">
						<span class="text-xs font-bold uppercase tracking-wider text-slate-400">Changed Files</span>
						<span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-slate-800 text-slate-300">
							{ strconv.Itoa(len(data.Files)) }
						</span>
					</div>
					if len(data.Files) > 0 {
						<div class="flex items-center space-x-2 text-xs">
							<span class="text-slate-400 font-mono text-[11px]">
								{ fmt.Sprintf("%d of %d reviewed by %s", data.ReviewedFilesCount, len(data.Files), data.ActiveReviewer) }
							</span>
							if data.ReviewedFilesCount == len(data.Files) {
								<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950/70 text-emerald-400 border border-emerald-800/40">All reviewed ✓</span>
							}
						</div>
					}
				</div>

				if len(data.Files) == 0 {
					<div class="py-6 text-center text-xs text-slate-500 font-mono">
						No modified, added, or deleted files between chosen patchsets.
					</div>
				} else {
					<div class="overflow-x-auto rounded-lg border border-slate-800/80 bg-[#0d1424]">
						<table class="w-full text-left font-mono text-xs">
							<thead class="bg-slate-900/80 text-slate-400 border-b border-slate-800 text-[11px] uppercase">
								<tr>
									<th class="w-16 px-3 py-2 text-center">Status</th>
									<th class="px-3 py-2">Path</th>
									<th class="w-32 px-3 py-2 text-center">Review</th>
									<th class="w-28 px-3 py-2 text-right">Diff</th>
									<th class="w-32 px-3 py-2 text-center">Comments</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/50">
								for _, f := range data.Files {
									<tr class={ "hover:bg-slate-800/50 transition cursor-pointer", templ.KV("bg-sky-950/20 font-semibold", f.Path == data.SelectedFilePath) }>
										<td class="px-3 py-2 text-center">
											switch f.Type {
												case "M":
													<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">M</span>
												case "A":
													<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">A</span>
												case "D":
													<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">D</span>
												default:
													<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-500/20 text-slate-400">M</span>
											}
										</td>
										<td class="px-3 py-2">
											<a
												href={ templ.SafeURL(fmt.Sprintf("/cl/%d/file/%s?ps=%d&base_ps=%d", data.CL.CLID, f.Path, data.CurrentPatchset, data.BasePatchset)) }
												class="text-slate-200 hover:text-sky-400 transition"
											>
												{ f.Path }
											</a>
										</td>
										<td class="w-32 px-3 py-2 text-center">
											@FileReviewBadge(data.CL.CLID, f.Path, f.Reviewed, data.CurrentPatchset, data.BasePatchset)
										</td>
										<td class="px-3 py-2 text-right font-mono text-[11px]">
											<span class="text-emerald-400">{ fmt.Sprintf("+%d", f.Additions) }</span>
											<span class="text-slate-600">/</span>
											<span class="text-rose-400">{ fmt.Sprintf("-%d", f.Deletions) }</span>
										</td>
										<td class="px-3 py-2 text-center">
											if f.UnresolvedComments > 0 {
												<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-950/70 text-amber-300 border border-amber-800/40">
													<span>💬</span>
													<span>{ strconv.Itoa(f.UnresolvedComments) }</span>
												</span>
											} else {
												<span class="text-slate-600 text-[10px]">—</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Side-by-Side Diff Container for Selected File -->
			<div class="flex-1 flex flex-col">
				if data.SelectedFileDiff != nil {
					@DiffView(data.CL.CLID, data.CurrentPatchset, data.BasePatchset, data.SelectedFileDiff, data.CommentsByLine)
				} else if len(data.Files) > 0 {
					<div class="p-16 text-center text-slate-500 font-mono text-sm">
						Select a file from the changed files list above to review its side-by-side diff.
					</div>
				}
			</div>
			@ReplyModal(data.CL.CLID, data.ActiveReviewer, data.DraftCommentsCount, data.DraftComments)
		</div>
	}
}

templ StatusBadge(status string, isApproved bool) {
	if isApproved && status != "submitted" {
		<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950 text-emerald-400 border border-emerald-800 flex items-center space-x-1">
			<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
			<span>Approved</span>
		</span>
	} else {
		switch status {
			case "submitted":
				<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-950 text-sky-400 border border-sky-800">
					Submitted
				</span>
			case "shelved":
				<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-950 text-indigo-400 border border-indigo-800">
					Shelved
				</span>
			default:
				<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-950 text-amber-400 border border-amber-800">
					Under Review
				</span>
		}
	}
}

templ ApprovalButtons(clID int64, approvals []db.Approval) {
	<div class="flex items-center space-x-2">
		<button
			type="button"
			hx-post={ fmt.Sprintf("/cl/%d/approval?verdict=lgtm", clID) }
			hx-target="#approvals-control"
			hx-swap="outerHTML"
			class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-emerald-600/20 transition flex items-center space-x-1.5"
		>
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
			<span>LGTM / Approve</span>
		</button>
		<button
			type="button"
			hx-post={ fmt.Sprintf("/cl/%d/approval?verdict=changes_requested", clID) }
			hx-target="#approvals-control"
			hx-swap="outerHTML"
			class="px-3 py-1.5 bg-rose-900/60 hover:bg-rose-800 text-rose-200 border border-rose-700/60 rounded-lg text-xs font-semibold transition flex items-center space-x-1.5"
		>
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
			<span>Request Changes</span>
		</button>
	</div>
}

func isCLApproved(approvals []db.Approval) bool {
	hasLGTM := false
	for _, a := range approvals {
		if a.Verdict == "changes_requested" {
			return false
		}
		if a.Verdict == "approved" || a.Verdict == "lgtm" {
			hasLGTM = true
		}
	}
	return hasLGTM
}

func getVerdictClass(verdict string) string {
	switch verdict {
	case "approved", "lgtm":
		return "bg-emerald-950/80 text-emerald-300 border border-emerald-800/60"
	case "changes_requested":
		return "bg-rose-950/80 text-rose-300 border border-rose-800/60"
	default:
		return "bg-slate-800 text-slate-300 border border-slate-700"
	}
}

func pluralS(count int) string {
	if count == 1 {
		return ""
	}
	return "s"
}

templ FileReviewBadge(clID int64, filePath string, reviewed bool, currentPS int, basePS int) {
	<div
		id={ fmt.Sprintf("file-review-badge-%s", sanitizeHTMLID(filePath)) }
		class="inline-flex items-center justify-center"
	>
		<button
			type="button"
			hx-post={ fmt.Sprintf("/cl/%d/file-review?file=%s&reviewed=%t&ps=%d&base_ps=%d", clID, filePath, !reviewed, currentPS, basePS) }
			hx-target={ fmt.Sprintf("#file-review-badge-%s", sanitizeHTMLID(filePath)) }
			hx-swap="outerHTML"
			class="focus:outline-none cursor-pointer group"
			title={ fmt.Sprintf("Click to mark as %s", mapBool(reviewed, "not reviewed", "reviewed")) }
		>
			if reviewed {
				<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/50 shadow-sm shadow-emerald-950/40 group-hover:bg-emerald-900/40 transition">
					<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>reviewed</span>
				</span>
			} else {
				<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-800/80 text-slate-400 border border-slate-700/60 group-hover:text-slate-200 group-hover:border-slate-500 transition">
					<span class="w-1.5 h-1.5 rounded-full bg-slate-500 group-hover:bg-slate-300"></span>
					<span>not reviewed</span>
				</span>
			}
		</button>
	</div>
}

func mapBool(b bool, trueStr, falseStr string) string {
	if b {
		return trueStr
	}
	return falseStr
}

func sanitizeHTMLID(s string) string {
	res := strings.ReplaceAll(s, "/", "-")
	res = strings.ReplaceAll(res, ".", "-")
	res = strings.ReplaceAll(res, "_", "-")
	return res
}

