package views

import (
	"context"
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"sync/atomic"
	"niebla/internal/db"
)

type aiHintsCtxKey struct{}

var defaultAIHintsEnabled atomic.Bool

// SetDefaultAIHintsEnabled sets the process-wide default for whether an OpenAI-compatible
// endpoint is configured and AI hint UI controls should be rendered.
func SetDefaultAIHintsEnabled(enabled bool) {
	defaultAIHintsEnabled.Store(enabled)
}

// WithAIHintsEnabled attaches a per-request flag indicating whether AI hint UI controls should be rendered.
func WithAIHintsEnabled(ctx context.Context, enabled bool) context.Context {
	if ctx == nil {
		ctx = context.Background()
	}
	return context.WithValue(ctx, aiHintsCtxKey{}, enabled)
}

// IsAIHintsEnabled returns true only when an OpenAI-compatible endpoint is configured.
func IsAIHintsEnabled(ctx context.Context) bool {
	if ctx != nil {
		if v, ok := ctx.Value(aiHintsCtxKey{}).(bool); ok {
			return v
		}
	}
	return defaultAIHintsEnabled.Load()
}

templ CommentBox(clID int64, patchsetNumber int, filePath string, line int, endLine int, side string, comments []db.Comment, draftCount ...int) {
	if endLine < line {
		{{ endLine = line }}
	}
	if len(comments) > 0 {
		if comments[0].LineNumber > 0 {
			{{ line = comments[0].LineNumber }}
		}
		if comments[0].EndLineNumber >= line {
			{{ endLine = comments[0].EndLineNumber }}
		}
	}
	<td colspan="4" class="p-0 border-y-2 border-sky-800/60 bg-[#0a0f1d] shadow-inner">
		<div id={ fmt.Sprintf("comment-container-%s-%d", sanitizeHTMLID(filePath), endLine) } class="px-6 py-4 max-w-4xl mx-auto my-2 rounded-xl border border-slate-700/60 bg-[#0f172a] shadow-2xl">
			<!-- Thread Header -->
			<div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800">
				<div class="flex items-center space-x-2 text-xs">
					<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-sky-950/70 text-sky-400 border border-sky-800/50">
						if endLine > line {
							{ fmt.Sprintf("%s : Lines %d–%d (%s)", filePath, line, endLine, side) }
						} else {
							{ fmt.Sprintf("%s : Line %d (%s)", filePath, line, side) }
						}
					</span>
					if hasPublishedComments(comments) {
						if isThreadResolved(comments) {
							<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/40">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
								<span>Resolved</span>
							</span>
						} else {
							<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-950/60 text-amber-400 border border-amber-800/40">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"></circle><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"></path></svg>
								<span>Unresolved</span>
							</span>
						}
					}
					if !hasPublishedComments(comments) && len(comments) > 0 {
						<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-950/40 text-amber-300 border border-amber-800/40 font-mono">
							<span>Draft Pending</span>
						</span>
					}
				</div>
				<div class="flex items-center space-x-2">
					if len(comments) == 0 {
						<button
							type="button"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('comment-row-%s-%d').innerHTML = '';", sanitizeHTMLID(filePath), endLine)} }
							class="text-xs text-slate-400 hover:text-slate-200 px-2 py-1 rounded hover:bg-slate-800 transition"
						>
							Cancel
						</button>
					}
				</div>
			</div>

			<!-- Comment Thread List -->
			if len(comments) > 0 {
				<div class="space-y-3 mb-4">
					for _, c := range comments {
						<div class={ "p-3 rounded-lg border text-xs transition",
							templ.KV("bg-amber-950/20 border-amber-800/50", c.IsDraft),
							templ.KV("bg-slate-900/90 border-slate-800", !c.IsDraft && !c.Resolved),
							templ.KV("bg-emerald-950/20 border-emerald-900/30 opacity-80", !c.IsDraft && c.Resolved) }>
							<div class="flex items-center justify-between mb-1.5">
								<div class="flex items-center space-x-2">
									<div class="w-5 h-5 rounded-full bg-indigo-600/50 text-indigo-300 flex items-center justify-center font-bold text-[10px]">
										{ string([]rune(c.Author)[0]) }
									</div>
									<span class="font-semibold text-slate-200">{ c.Author }</span>
									<span class="text-[10px] text-slate-500">{ c.CreatedAt.Format("Jan 02, 15:04") }</span>
									if c.IsDraft {
										<span class="inline-flex items-center space-x-1 px-1.5 py-0.2 rounded text-[10px] font-mono font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/40">
											<span>Draft</span>
										</span>
									}
									if c.HasSuggestion {
										<span class="inline-flex items-center space-x-1 px-1.5 py-0.2 rounded text-[10px] font-mono font-semibold bg-sky-500/20 text-sky-300 border border-sky-500/40">
											<span>💡 AI / Code Suggestion</span>
										</span>
									}
								</div>
								<div class="flex items-center space-x-2">
									if c.IsDraft {
										<button
											type="button"
											hx-post={ fmt.Sprintf("/cl/%d/comments/%d/discard?author=%s", clID, c.ID, url.QueryEscape(c.Author)) }
											hx-target={ fmt.Sprintf("#comment-row-%s-%d", sanitizeHTMLID(filePath), endLine) }
											hx-swap="innerHTML"
											class="text-[11px] px-2 py-0.5 rounded font-medium bg-rose-950/40 hover:bg-rose-900/50 text-rose-300 border border-rose-800/40 transition flex items-center space-x-1"
											title="Discard this draft comment"
										>
											<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
											<span>Discard</span>
										</button>
									} else {
										<button
											type="button"
											hx-post={ fmt.Sprintf("/cl/%d/comments/%d/resolve?resolved=%t", clID, c.ID, !c.Resolved) }
											hx-target={ fmt.Sprintf("#comment-row-%s-%d", sanitizeHTMLID(filePath), endLine) }
											hx-swap="innerHTML"
											class={ "text-[11px] px-2 py-0.5 rounded font-medium transition flex items-center space-x-1", templ.KV("bg-emerald-900/40 text-emerald-300 hover:bg-emerald-800/50", !c.Resolved), templ.KV("bg-slate-800 text-slate-400 hover:bg-slate-700", c.Resolved) }
										>
											if c.Resolved {
												<span>Reopen</span>
											} else {
												<span>✓ Mark Resolved</span>
											}
										</button>
									}
								</div>
							</div>
							if c.BodyWithoutSuggestionFence() != "" {
								<div class="text-slate-300 whitespace-pre-wrap font-sans text-xs pl-7 leading-relaxed">
									{ c.BodyWithoutSuggestionFence() }
								</div>
							}
							if c.HasSuggestion && c.SuggestionCode != "" {
								@CommentSuggestionCard(clID, filePath, endLine, c)
							}
						</div>
					}
				</div>
			}

			<!-- Reply / New Comment Form -->
			<form
				id={ fmt.Sprintf("comment-form-%s-%d", sanitizeHTMLID(filePath), endLine) }
				hx-post={ fmt.Sprintf("/cl/%d/comments", clID) }
				hx-target={ fmt.Sprintf("#comment-row-%s-%d", sanitizeHTMLID(filePath), endLine) }
				hx-swap="innerHTML"
				class="space-y-3 pt-2"
			>
				<input type="hidden" name="cl_id" value={ strconv.FormatInt(clID, 10) }/>
				<input type="hidden" name="patchset_number" value={ strconv.Itoa(patchsetNumber) }/>
				<input type="hidden" name="file_path" value={ filePath }/>
				<input type="hidden" name="line_number" value={ strconv.Itoa(line) }/>
				<input type="hidden" name="end_line_number" value={ strconv.Itoa(endLine) }/>
				<input type="hidden" name="side" value={ side }/>
				<input type="hidden" id={ fmt.Sprintf("sugg-has-%s-%d", sanitizeHTMLID(filePath), endLine) } name="has_suggestion" value="false"/>
				<input type="hidden" id={ fmt.Sprintf("sugg-start-%s-%d", sanitizeHTMLID(filePath), endLine) } name="suggestion_start_line" value={ strconv.Itoa(line) }/>
				<input type="hidden" id={ fmt.Sprintf("sugg-end-%s-%d", sanitizeHTMLID(filePath), endLine) } name="suggestion_end_line" value={ strconv.Itoa(endLine) }/>
				<input type="hidden" id={ fmt.Sprintf("sugg-code-%s-%d", sanitizeHTMLID(filePath), endLine) } name="suggestion_code" value=""/>

				<div>
					<textarea
						id={ fmt.Sprintf("comment-body-%s-%d", sanitizeHTMLID(filePath), endLine) }
						name="body"
						rows="3"
						required
						placeholder="Write an inline comment draft..."
						class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 font-sans transition resize-y"
					></textarea>
				</div>

				if IsAIHintsEnabled(ctx) {
					<!-- AI Hint Preview Container -->
					<div id={ fmt.Sprintf("ai-hint-preview-%s-%d", sanitizeHTMLID(filePath), endLine) }></div>
				}

				<div class="flex items-center justify-between flex-wrap gap-2">
					<div class="flex items-center space-x-3 text-xs flex-wrap gap-y-1.5">
						<label class="flex items-center space-x-1.5 text-slate-400 text-xs cursor-pointer select-none">
							<input
								type="text"
								name="author"
								value={ ActiveUser() }
								class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-xs text-slate-300 w-24 font-mono focus:outline-none focus:border-sky-500"
								title="Comment Author"
							/>
							<span class="text-[11px] text-slate-500">(author)</span>
						</label>
						<label class="flex items-center space-x-1.5 text-slate-300 text-xs cursor-pointer select-none">
							<input
								type="checkbox"
								name="resolved"
								value="true"
								class="rounded bg-slate-900 border-slate-700 text-emerald-600 focus:ring-emerald-500 focus:ring-offset-0"
							/>
							<span>Resolve thread</span>
						</label>
						if IsAIHintsEnabled(ctx) {
							<label class="flex items-center space-x-1.5 text-sky-300 text-xs cursor-pointer select-none">
								<input
									type="checkbox"
									id={ fmt.Sprintf("ai-hint-cb-%s-%d", sanitizeHTMLID(filePath), endLine) }
									name="provide_ai_hint"
									value="true"
									onchange={ templ.ComponentScript{Call: fmt.Sprintf("const btn = document.getElementById('ai-hint-btn-%s-%d'); if (btn) { btn.classList.toggle('hidden', !this.checked); }", sanitizeHTMLID(filePath), endLine)} }
									class="rounded bg-slate-900 border-slate-700 text-sky-500 focus:ring-sky-500 focus:ring-offset-0"
								/>
								<span>🤖 Provide AI hint</span>
							</label>
							<button
								type="button"
								id={ fmt.Sprintf("ai-hint-btn-%s-%d", sanitizeHTMLID(filePath), endLine) }
								hx-post={ fmt.Sprintf("/cl/%d/ai-hint/generate", clID) }
								hx-include="closest form"
								hx-target={ fmt.Sprintf("#ai-hint-preview-%s-%d", sanitizeHTMLID(filePath), endLine) }
								hx-swap="innerHTML"
								class="hidden px-2.5 py-1 bg-sky-950/80 hover:bg-sky-900 text-sky-300 border border-sky-700/60 rounded-md text-[11px] font-semibold transition flex items-center space-x-1"
								title="Query the AI hint agent with your comment and selected lines"
							>
								<span>✨ Generate Hint</span>
							</button>
						}
					</div>
					<div class="flex items-center space-x-2">
						<button
							type="submit"
							class="px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-amber-600/30 transition flex items-center space-x-1.5"
							title="Save this inline comment as a draft. Click Reply in the header to post all drafts to the CL."
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
							<span>Save Draft</span>
						</button>
					</div>
				</div>
			</form>
		</div>

		if len(draftCount) > 0 && draftCount[0] >= 0 {
			<div id="cl-reply-btn-container" hx-swap-oob="true">
				@ReplyButton(clID, draftCount[0])
			</div>
		}
	</td>
}

templ CommentSuggestionCard(clID int64, filePath string, threadEndLine int, c db.Comment) {
	<div class="ml-7 mt-2.5 rounded-lg border border-sky-800/60 bg-[#080d19] overflow-hidden shadow-md">
		<div class="px-3 py-1.5 bg-sky-950/40 border-b border-sky-900/50 flex items-center justify-between">
			<div class="flex items-center space-x-2 text-[11px] font-mono">
				<span class="text-sky-400 font-semibold">💡 Suggested change</span>
				<span class="text-slate-500">
					if c.SuggestionEndLine > c.SuggestionStartLine {
						{ fmt.Sprintf("(Lines %d–%d)", c.SuggestionStartLine, c.SuggestionEndLine) }
					} else if c.SuggestionStartLine > 0 {
						{ fmt.Sprintf("(Line %d)", c.SuggestionStartLine) }
					}
				</span>
			</div>
			<div class="flex items-center space-x-2">
				if c.SuggestionAppliedPS > 0 {
					<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-950/70 text-emerald-400 border border-emerald-800/60">
						<span>✓ Applied in PS { strconv.Itoa(c.SuggestionAppliedPS) }</span>
					</span>
				} else if c.SuggestionAppliedPS < 0 {
					<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-rose-950/70 text-rose-400 border border-rose-800/60">
						<span>✕ Suggestion Rejected</span>
					</span>
				} else if !c.IsDraft {
					<button
						type="button"
						hx-post={ fmt.Sprintf("/cl/%d/comments/%d/apply-suggestion", clID, c.ID) }
						hx-target={ fmt.Sprintf("#comment-row-%s-%d", sanitizeHTMLID(filePath), threadEndLine) }
						hx-swap="innerHTML"
						class="px-2.5 py-0.5 bg-sky-600 hover:bg-sky-500 text-white rounded text-[11px] font-semibold shadow-sm transition flex items-center space-x-1 cursor-pointer"
						title="Apply this suggested code change, create a new patchset, and resolve this thread"
					>
						<span>✓ Apply Suggestion</span>
					</button>
					<button
						type="button"
						hx-post={ fmt.Sprintf("/cl/%d/comments/%d/reject-suggestion", clID, c.ID) }
						hx-target={ fmt.Sprintf("#comment-row-%s-%d", sanitizeHTMLID(filePath), threadEndLine) }
						hx-swap="innerHTML"
						class="px-2 py-0.5 bg-slate-800 hover:bg-rose-950/60 text-slate-300 hover:text-rose-300 border border-slate-700 rounded text-[11px] font-medium transition cursor-pointer"
						title="Reject this code suggestion"
					>
						<span>✕ Reject</span>
					</button>
				}
			</div>
		</div>
		<pre class="p-3 text-xs font-mono leading-relaxed overflow-x-auto bg-emerald-950/20 text-emerald-200 border-l-2 border-emerald-500"><code>{ formatPlusLines(c.SuggestionCode) }</code></pre>
	</div>
}

templ AIHintPreviewCard(clID int64, filePath string, endLine int, explanation string, targetCode string, replacementStart int, replacementEnd int, replacementCode string, apertureUsed string, errMsg string) {
	<div class="rounded-lg border border-sky-700/70 bg-[#070c18] p-3 space-y-2.5 text-xs shadow-lg">
		<div class="flex items-center justify-between border-b border-slate-800 pb-2">
			<div class="flex items-center space-x-2">
				<span class="font-semibold text-sky-400 font-mono">🤖 AI Hint Preview</span>
				if apertureUsed != "" {
					<span class="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-700 text-[10px] font-mono text-slate-400">
						{ fmt.Sprintf("aperture: %s", apertureUsed) }
					</span>
				}
			</div>
			<button
				type="button"
				onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('ai-hint-preview-%s-%d').innerHTML = '';", sanitizeHTMLID(filePath), endLine)} }
				class="text-[11px] text-slate-400 hover:text-slate-200 px-1.5 py-0.5 rounded hover:bg-slate-800 transition"
			>
				✕ Dismiss
			</button>
		</div>

		if errMsg != "" {
			<div class="text-rose-400 font-mono text-[11px] bg-rose-950/30 border border-rose-800/50 rounded p-2">
				{ errMsg }
			</div>
		} else {
			if explanation != "" {
				<div class="text-slate-300 text-xs leading-relaxed">
					💡 { explanation }
				</div>
			}
			if replacementCode != "" {
				<div class="rounded border border-slate-800 overflow-hidden font-mono text-[11px]">
					if targetCode != "" {
						<pre class="px-3 py-1.5 bg-rose-950/25 text-rose-300 border-l-2 border-rose-500 overflow-x-auto"><code>{ formatMinusLines(targetCode) }</code></pre>
					}
					<pre class="px-3 py-1.5 bg-emerald-950/25 text-emerald-200 border-l-2 border-emerald-500 overflow-x-auto"><code>{ formatPlusLines(replacementCode) }</code></pre>
				</div>
				<div class="flex items-center justify-end space-x-2 pt-1">
					<textarea id={ fmt.Sprintf("ai-raw-code-%s-%d", sanitizeHTMLID(filePath), endLine) } class="hidden">{ replacementCode }</textarea>
					<button
						type="button"
						onclick={ acceptAIHintScript(sanitizeHTMLID(filePath), endLine, replacementStart, replacementEnd) }
						class="px-3 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-md text-xs font-semibold shadow-sm transition flex items-center space-x-1 cursor-pointer"
					>
						<span>✓ Accept Hint into Comment</span>
					</button>
				</div>
			} else {
				<div class="text-slate-400 italic text-[11px]">
					No direct code replacement required for this comment.
				</div>
			}
		}
	</div>
}

func acceptAIHintScript(safeID string, endLine int, replStart int, replEnd int) templ.ComponentScript {
	call := fmt.Sprintf(
		"(function(){ const rawEl = document.getElementById('ai-raw-code-%s-%d'); const bodyEl = document.getElementById('comment-body-%s-%d'); const hasEl = document.getElementById('sugg-has-%s-%d'); const startEl = document.getElementById('sugg-start-%s-%d'); const endEl = document.getElementById('sugg-end-%s-%d'); const codeEl = document.getElementById('sugg-code-%s-%d'); if (!rawEl || !bodyEl) return; const code = rawEl.value; if (hasEl) hasEl.value = 'true'; if (startEl) startEl.value = '%d'; if (endEl) endEl.value = '%d'; if (codeEl) codeEl.value = code; const fence = '```suggestion\\n' + code + '\\n```'; if (!bodyEl.value.includes('```suggestion')) { bodyEl.value = (bodyEl.value.trim() ? bodyEl.value.trim() + '\\n\\n' : '') + fence; } })()",
		safeID, endLine,
		safeID, endLine,
		safeID, endLine,
		safeID, endLine,
		safeID, endLine,
		safeID, endLine,
		replStart, replEnd,
	)
	return templ.ComponentScript{Call: call}
}

func formatPlusLines(code string) string {
	lines := strings.Split(strings.ReplaceAll(code, "\r\n", "\n"), "\n")
	for i, l := range lines {
		lines[i] = "+ " + l
	}
	return strings.Join(lines, "\n")
}

func formatMinusLines(code string) string {
	lines := strings.Split(strings.ReplaceAll(code, "\r\n", "\n"), "\n")
	for i, l := range lines {
		lines[i] = "- " + l
	}
	return strings.Join(lines, "\n")
}

func hasPublishedComments(comments []db.Comment) bool {
	for _, c := range comments {
		if !c.IsDraft {
			return true
		}
	}
	return false
}

func isThreadResolved(comments []db.Comment) bool {
	published := 0
	for _, c := range comments {
		if !c.IsDraft {
			published++
			if !c.Resolved {
				return false
			}
		}
	}
	return published > 0
}
