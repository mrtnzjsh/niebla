package views

import (
	"fmt"
	"strconv"
	"strings"
	"niebla/internal/db"
	"niebla/internal/web/diff"
)

// CIRunnerItem represents a CI runner assigned or reporting for a CL patchset.
type CIRunnerItem struct {
	RunnerName  string
	Provider    string
	Status      string // queued, running, passed, failed, canceled, skipped
	IsRequired  bool
	ExternalURL string
	LogBlobHex  string
	Duration    string
}

// CLDetailData contains all context needed to render a changelist review page.
type CLDetailData struct {
	CL                        *db.Changelist
	Patchsets                 []db.Patchset
	CurrentPatchset           int
	BasePatchset              int
	Files                     []diff.FileDiffSummary
	SelectedFilePath          string
	SelectedFileDiff          *diff.FileDiffDetail
	CommentsByLine            map[int][]db.Comment
	Approvals                 []db.Approval
	Reviewers                 []db.ReviewerAssignment
	RequiredApprovals         int
	ApprovedCount             int
	AllowSubmitWithUnresolved bool
	UnresolvedComments        int
	ActiveReviewer            string
	ReviewedFilesCount        int
	DraftCommentsCount        int
	DraftComments             []db.Comment
	CIRunners                 []CIRunnerItem
}

templ CLDetail(data CLDetailData) {
	@Layout(fmt.Sprintf("CL %d: %s", data.CL.CLID, data.CL.Description)) {
		<div class="flex-1 flex flex-col bg-[#090d16]">
			<!-- CL Header Overview -->
			<div class="border-b border-slate-800 bg-[#0c1322] px-6 py-3.5 shadow-sm">
				if data.CL.ParentCL != nil && *data.CL.ParentCL > 0 {
					<div class="flex items-center space-x-2 text-[11px] font-mono text-slate-400 mb-2">
						<span class="text-slate-500 uppercase tracking-wider text-[10px]">Stack:</span>
						<a href={ templ.SafeURL(fmt.Sprintf("/cl/%d", *data.CL.ParentCL)) } class="text-sky-400 hover:text-sky-300 hover:underline flex items-center space-x-1">
							<span>Parent CL</span>
							<span class="font-bold">{ fmt.Sprintf("#%d", *data.CL.ParentCL) }</span>
						</a>
						<span class="text-slate-600">──►</span>
						<span class="text-slate-200 font-bold bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700/60">
							{ fmt.Sprintf("CL #%d (Active)", data.CL.CLID) }
						</span>
					</div>
				}

				if data.CL.NeedsRebase {
					<div class="mb-3 px-4 py-3 bg-amber-950/70 border border-amber-600/70 rounded-xl flex items-center justify-between text-amber-200 text-xs shadow-lg">
						<div class="flex items-center space-x-3">
							<span class="text-lg">⚠️</span>
							<div>
								<div class="font-bold font-mono text-amber-300">
									if data.CL.ParentCL != nil {
										{ fmt.Sprintf("Rebase Required: Parent CL #%d updated with conflicts", *data.CL.ParentCL) }
									} else {
										Rebase Required: Conflicts detected with parent CL
									}
								</div>
								<div class="text-[11px] text-amber-200/80 mt-0.5">
									Run <code class="bg-black/50 px-1.5 py-0.5 rounded font-mono text-amber-300 border border-amber-800/50">niebla sync</code> in your workspace to pull conflict markers and resolve.
								</div>
								if data.CL.RebaseConflictDetails != nil && *data.CL.RebaseConflictDetails != "" {
									<div class="text-[11px] text-amber-400/90 font-mono mt-1">
										Conflicts: { *data.CL.RebaseConflictDetails }
									</div>
								}
							</div>
						</div>
					</div>
				}

				<!-- Centered Actions Row: Reply and Submit -->
				@CenterActions(data)

				<div class="mt-3 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
					<!-- CL Identity and Status -->
					<div class="flex flex-col space-y-1.5">
						<div class="flex items-center space-x-3">
							<span class="text-xl font-bold tracking-tight text-white font-mono">
								{ fmt.Sprintf("CL %d", data.CL.CLID) }
							</span>
							<div id="cl-status-badge">
								@StatusBadge(data.CL.Status, isCLApproved(data.Approvals))
							</div>
							<span class="text-xs text-slate-400 font-mono">
								{ fmt.Sprintf("by %s", data.CL.Author) }
							</span>
							<span class="text-slate-600">•</span>
							<span class="text-xs text-slate-500 font-mono">
								{ data.CL.CommittedAt.Format("Jan 02, 2006 15:04 MST") }
							</span>
						</div>
						<!-- Description -->
						<div class="text-sm text-slate-300 font-sans max-w-3xl whitespace-pre-wrap leading-relaxed">
							{ data.CL.Description }
						</div>
					</div>

					<!-- Reviewer Approvals, Reviewers List & Actions Bar -->
					@CLActionsBar(data)
				</div>

				<!-- Patchset Selector & Unresolved Summary Bar -->
				<div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
					<!-- Patchset Selector Dropdown -->
					<div class="flex items-center space-x-2">
						<span class="text-slate-400 font-medium">Patchset:</span>
						<div class="relative inline-block">
							<select
								id="patchset-selector"
								class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs font-mono text-slate-200 focus:outline-none focus:border-sky-500 cursor-pointer"
								onchange={ templ.ComponentScript{Call: fmt.Sprintf("window.location.href = '/cl/%d?ps=' + this.value.split(':')[0] + '&base_ps=' + this.value.split(':')[1];", data.CL.CLID)} }
							>
								for _, ps := range data.Patchsets {
									<option
										value={ fmt.Sprintf("%d:0", ps.PatchsetNumber) }
										selected?={ ps.PatchsetNumber == data.CurrentPatchset && data.BasePatchset == 0 }
									>
										{ fmt.Sprintf("Patchset %d vs Base CL", ps.PatchsetNumber) }
									</option>
								}
								<!-- Inter-patchset comparisons if multiple patchsets exist -->
								if len(data.Patchsets) > 1 {
									for i := 1; i < len(data.Patchsets); i++ {
										for j := 0; j < i; j++ {
											<option
												value={ fmt.Sprintf("%d:%d", data.Patchsets[i].PatchsetNumber, data.Patchsets[j].PatchsetNumber) }
												selected?={ data.Patchsets[i].PatchsetNumber == data.CurrentPatchset && data.Patchsets[j].PatchsetNumber == data.BasePatchset }
											>
												{ fmt.Sprintf("Patchset %d vs Patchset %d (inter-diff)", data.Patchsets[i].PatchsetNumber, data.Patchsets[j].PatchsetNumber) }
											</option>
										}
									}
								}
							</select>
						</div>
						<span class="text-slate-600 font-mono text-[11px]">
							{ fmt.Sprintf("(%d patchset%s available)", len(data.Patchsets), pluralS(len(data.Patchsets))) }
						</span>
					</div>

					<!-- Comments Summary Count -->
					<div class="flex items-center space-x-2">
						if data.UnresolvedComments > 0 {
							<span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-950/60 text-amber-300 border border-amber-800/50">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
								<span>{ fmt.Sprintf("%d Unresolved Comment%s", data.UnresolvedComments, pluralS(data.UnresolvedComments)) }</span>
							</span>
						} else {
							<span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-md text-xs font-medium bg-emerald-950/40 text-emerald-400 border border-emerald-900/40">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								<span>All comments resolved</span>
							</span>
						}
					</div>
				</div>
			</div>

			<!-- CI Runners & Checks Block -->
			@CIRunnersBlock(data)

			<!-- Changed Files Table -->
			<div class="bg-[#0b101d] border-b border-slate-800 px-6 py-3">
				<div class="flex items-center justify-between mb-2">
					<div class="flex items-center space-x-2">
						<span class="text-xs font-bold uppercase tracking-wider text-slate-400">Changed Files</span>
						<span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-slate-800 text-slate-300">
							{ strconv.Itoa(len(data.Files)) }
						</span>
					</div>
					if len(data.Files) > 0 {
						<div class="flex items-center space-x-2 text-xs">
							<span class="text-slate-400 font-mono text-[11px]">
								{ fmt.Sprintf("%d of %d reviewed by %s", data.ReviewedFilesCount, len(data.Files), data.ActiveReviewer) }
							</span>
							if data.ReviewedFilesCount == len(data.Files) {
								<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950/70 text-emerald-400 border border-emerald-800/40">All reviewed ✓</span>
							}
						</div>
					}
				</div>

				if len(data.Files) == 0 {
					<div class="py-6 text-center text-xs text-slate-500 font-mono">
						No modified, added, or deleted files between chosen patchsets.
					</div>
				} else {
					<div class="overflow-x-auto rounded-lg border border-slate-800/80 bg-[#0d1424]">
						<table class="w-full text-left font-mono text-xs">
							<thead class="bg-slate-900/80 text-slate-400 border-b border-slate-800 text-[11px] uppercase">
								<tr>
									<th class="w-16 px-3 py-2 text-center">Status</th>
									<th class="px-3 py-2">Path</th>
									<th class="w-32 px-3 py-2 text-center">Review</th>
									<th class="w-28 px-3 py-2 text-right">Diff</th>
									<th class="w-32 px-3 py-2 text-center">Comments</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/50">
								for _, file := range data.Files {
									<tr
										id={ fmt.Sprintf("file-row-%s", sanitizeHTMLID(file.Path)) }
										class={ "hover:bg-slate-800/60 transition cursor-pointer select-none group",
											templ.KV("bg-sky-950/20 font-semibold", file.Path == data.SelectedFilePath) }
										onclick={ templ.ComponentScript{Call: fmt.Sprintf("toggleFileAccordion('%d', '%s', '%s', '%d', '%d');", data.CL.CLID, sanitizeHTMLID(file.Path), file.Path, data.CurrentPatchset, data.BasePatchset)} }
									>
										<td class="w-16 px-3 py-2 text-center">
											<div class="flex items-center justify-center space-x-1.5">
												<button
													type="button"
													id={ fmt.Sprintf("chevron-%s", sanitizeHTMLID(file.Path)) }
													class={ "text-slate-500 group-hover:text-slate-300 transition-transform duration-200",
														templ.KV("rotate-90", file.Path == data.SelectedFilePath && data.SelectedFileDiff != nil) }
													title="Toggle inline diff"
												>
													<svg class="w-3.5 h-3.5 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
													</svg>
												</button>
												switch file.Type {
													case "M":
														<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">M</span>
													case "A":
														<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">A</span>
													case "D":
														<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">D</span>
													default:
														<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-500/20 text-slate-400">M</span>
												}
											</div>
										</td>
										<td class="px-3 py-2">
											<a
												href={ templ.SafeURL(fmt.Sprintf("/cl/%d/file/%s?ps=%d&base_ps=%d", data.CL.CLID, file.Path, data.CurrentPatchset, data.BasePatchset)) }
												target="_blank"
												rel="noopener noreferrer"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("handleFilenameClick(event, '%s');", sanitizeHTMLID(file.Path))} }
												class="text-slate-200 hover:text-sky-400 transition"
												title="Open diff in a new tab"
											>
												{ file.Path }
											</a>
										</td>
										<td class="w-32 px-3 py-2 text-center" onclick="event.stopPropagation()">
											@FileReviewBadge(data.CL.CLID, file.Path, file.Reviewed, data.CurrentPatchset, data.BasePatchset)
										</td>
										<td class="px-3 py-2 text-right font-mono text-[11px]">
											<span class="text-emerald-400">{ fmt.Sprintf("+%d", file.Additions) }</span>
											<span class="text-slate-600">/</span>
											<span class="text-rose-400">{ fmt.Sprintf("-%d", file.Deletions) }</span>
										</td>
										<td class="px-3 py-2 text-center">
											if file.UnresolvedComments > 0 {
												<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-950/70 text-amber-300 border border-amber-800/40">
													<span>💬</span>
													<span>{ strconv.Itoa(file.UnresolvedComments) }</span>
												</span>
											} else {
												<span class="text-slate-600 text-[10px]">—</span>
											}
										</td>
									</tr>
									<!-- Inline Accordion Row for Diff -->
									<tr
										id={ fmt.Sprintf("accordion-row-%s", sanitizeHTMLID(file.Path)) }
										class={ "border-b border-slate-800 bg-[#090d16]",
											templ.KV("hidden", file.Path != data.SelectedFilePath || data.SelectedFileDiff == nil) }
									>
										<td colspan="5" class="p-0">
											<div id={ fmt.Sprintf("diff-content-%s", sanitizeHTMLID(file.Path)) } class="w-full">
												if file.Path == data.SelectedFilePath && data.SelectedFileDiff != nil {
													@DiffView(data.CL.CLID, data.CurrentPatchset, data.BasePatchset, data.SelectedFileDiff, data.CommentsByLine)
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			@ReplyModal(data.CL.CLID, data.ActiveReviewer, data.DraftCommentsCount, data.DraftComments)
			@UnresolvedCommentsModal(data)
			@OverrideApprovalsModal(data)
			<script>
				function toggleFileAccordion(clID, safeID, filePath, currentPS, basePS) {
					const row = document.getElementById('accordion-row-' + safeID);
					const content = document.getElementById('diff-content-' + safeID);
					const chevron = document.getElementById('chevron-' + safeID);
					if (!row || !content) return;

					const isOpen = !row.classList.contains('hidden');
					if (isOpen) {
						row.classList.add('hidden');
						if (chevron) chevron.classList.remove('rotate-90');
						content.innerHTML = '';
					} else {
						row.classList.remove('hidden');
						if (chevron) chevron.classList.add('rotate-90');
						content.innerHTML = '<div class="p-8 text-center text-xs text-slate-400 font-mono flex items-center justify-center space-x-2"><svg class="w-4 h-4 animate-spin text-sky-400" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="32" stroke-linecap="round"></circle></svg><span>Loading fresh diff...</span></div>';
						const url = '/cl/' + clID + '/diff-content?file=' + encodeURIComponent(filePath) + '&ps=' + currentPS + '&base_ps=' + basePS;
						htmx.ajax('GET', url, { target: '#diff-content-' + safeID, swap: 'innerHTML' });
					}
				}

				function handleFilenameClick(event, safeID) {
					event.stopPropagation();
					const row = document.getElementById('accordion-row-' + safeID);
					const content = document.getElementById('diff-content-' + safeID);
					const chevron = document.getElementById('chevron-' + safeID);
					if (row && !row.classList.contains('hidden')) {
						row.classList.add('hidden');
						if (chevron) chevron.classList.remove('rotate-90');
						if (content) content.innerHTML = '';
					}
				}
			</script>
		</div>
	}
}

templ CLActionsBar(data CLDetailData) {
	<div id="cl-actions-bar" class="flex flex-col items-start lg:items-end space-y-2">
		@ApprovalsControl(data)
		@ReviewersControl(data)
	</div>
}

templ ApprovalsControl(data CLDetailData) {
	if data.CL.Status != "submitted" {
		<div id="approvals-control" class="flex items-center space-x-2">
			@ApprovalButtons(data.CL.CLID, data.Approvals)
		</div>
	}
}

templ CenterActions(data CLDetailData) {
	<div id="cl-center-actions" class="flex items-center justify-center space-x-4">
		<div id="cl-reply-btn-container">
			@ReplyButton(data.CL.CLID, data.DraftCommentsCount)
		</div>
		<div id="cl-submit-btn-container">
			@SubmitButton(data)
		</div>
	</div>
}

templ SubmitButtonOOB(data CLDetailData) {
	<div id="cl-submit-btn-container" hx-swap-oob="true">
		@SubmitButton(data)
	</div>
}

templ ApprovalCheckmarks(requiredApprovals int, approvedCount int) {
	if requiredApprovals > 0 {
		<span class="inline-flex items-center space-x-0.5">
			for i := 0; i < requiredApprovals; i++ {
				if i < approvedCount {
					<svg class="w-3.5 h-3.5 text-current" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" title="Approval met">
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
					</svg>
				} else {
					<svg class="w-3.5 h-3.5 text-black" fill="none" stroke="#000000" stroke-width="2.5" viewBox="0 0 24 24" title="Missing approval">
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
					</svg>
				}
			}
		</span>
	} else {
		<svg class="w-3.5 h-3.5 text-current" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
		</svg>
	}
}

templ SubmitButton(data CLDetailData) {
	if data.CL.Status == "submitted" {
		<span class="px-3 py-1.5 bg-slate-800 text-slate-500 border border-slate-700/50 rounded-lg text-xs font-semibold flex items-center space-x-1.5 cursor-not-allowed">
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
			<span>CL Submitted</span>
		</span>
	} else if data.CL.NeedsRebase {
		<button
			type="button"
			id="submit-cl-btn"
			disabled
			class="px-3 py-1.5 bg-slate-800 text-amber-400 border border-amber-700/60 rounded-lg text-xs font-semibold flex items-center space-x-1.5 cursor-not-allowed opacity-90 shadow-md"
			title="Cannot submit: CL has pending rebase conflicts with parent CL. Run 'niebla sync' in your workspace to resolve."
		>
			<svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
			<span>Rebase Conflict</span>
		</button>
	} else if data.UnresolvedComments > 0 && !data.AllowSubmitWithUnresolved {
		<button
			type="button"
			id="submit-cl-btn"
			onclick="const m = document.getElementById('unresolved-comments-modal'); if (m) { m.showModal(); }"
			class="px-3 py-1.5 bg-slate-800 hover:bg-amber-950/60 text-amber-300 border border-amber-700/60 rounded-lg text-xs font-semibold shadow-md transition flex items-center space-x-1.5 cursor-pointer"
			title="Cannot submit: unresolved comments exist"
		>
			@ApprovalCheckmarks(data.RequiredApprovals, data.ApprovedCount)
			<span>Submit CL</span>
		</button>
	} else if data.RequiredApprovals > 0 && data.ApprovedCount < data.RequiredApprovals {
		<button
			type="button"
			id="submit-cl-btn"
			onclick="const m = document.getElementById('override-approvals-modal'); if (m) { m.showModal(); }"
			class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-sky-600/30 transition flex items-center space-x-1.5 cursor-pointer"
			title={ fmt.Sprintf("Requires %d approval(s) (current: %d). Click to override approvals and submit.", data.RequiredApprovals, data.ApprovedCount) }
		>
			@ApprovalCheckmarks(data.RequiredApprovals, data.ApprovedCount)
			<span>Submit CL</span>
		</button>
	} else {
		<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/cl/%d/submit", data.CL.CLID)) } class="inline">
			<button
				type="submit"
				id="submit-cl-btn"
				onclick="return confirm('Are you sure you want to submit this CL to trunk?');"
				class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-sky-600/30 transition flex items-center space-x-1.5 cursor-pointer"
				title="Submit this CL to trunk"
			>
				@ApprovalCheckmarks(data.RequiredApprovals, data.ApprovedCount)
				<span>Submit CL</span>
			</button>
		</form>
	}
}

templ ReviewersControl(data CLDetailData) {
	<div id="reviewers-control" class="flex flex-col items-start lg:items-end space-y-1.5 text-xs">
		<div class="flex flex-wrap items-center gap-2">
			<!-- Approvals vs Required Badge -->
			if data.RequiredApprovals > 0 {
				if data.ApprovedCount >= data.RequiredApprovals {
					<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-950/70 text-emerald-400 border border-emerald-800/50">
						<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
						<span>{ fmt.Sprintf("Approvals: %d of %d required", data.ApprovedCount, data.RequiredApprovals) }</span>
					</span>
				} else {
					<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-950/70 text-amber-300 border border-amber-800/50">
						<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
						<span>{ fmt.Sprintf("Approvals: %d of %d required", data.ApprovedCount, data.RequiredApprovals) }</span>
					</span>
				}
			} else if data.ApprovedCount > 0 {
				<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800 text-slate-300 border border-slate-700">
					<span>{ fmt.Sprintf("Approvals: %d (optional)", data.ApprovedCount) }</span>
				</span>
			}
		</div>

		<!-- Reviewers List and Inline Add -->
		<div class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
			<span class="text-slate-500 font-mono text-[11px]">Reviewers:</span>
			if len(data.Reviewers) == 0 {
				<span class="italic text-slate-600 text-[11px]">No reviewers assigned</span>
			} else {
				for _, reviewer := range data.Reviewers {
					<span class={ "inline-flex items-center space-x-1 pl-2 pr-1.5 py-0.5 rounded text-[11px] font-mono", getVerdictClass(reviewer.Verdict) }>
						if reviewer.Verdict == "lgtm" || reviewer.Verdict == "approved" {
							<span class="text-emerald-400">✓</span>
						} else if reviewer.Verdict == "changes_requested" {
							<span class="text-rose-400">!</span>
						} else {
							<span class="text-slate-400 opacity-70">⏳</span>
						}
						<span class="font-semibold">{ reviewer.Reviewer }</span>
						<span class="opacity-75 text-[10px]">({ reviewer.Verdict })</span>
						if data.CL.Status != "submitted" {
							<button
								type="button"
								hx-post={ fmt.Sprintf("/cl/%d/reviewers/%s/remove", data.CL.CLID, reviewer.Reviewer) }
								hx-target="#cl-actions-bar"
								hx-swap="outerHTML"
								title={ fmt.Sprintf("Remove %s", reviewer.Reviewer) }
								class="ml-1 text-slate-400 hover:text-rose-400 transition cursor-pointer p-0.5 rounded"
							>
								✕
							</button>
						}
					</span>
				}
			}

			if data.CL.Status != "submitted" {
				<form
					hx-post={ fmt.Sprintf("/cl/%d/reviewers", data.CL.CLID) }
					hx-target="#cl-actions-bar"
					hx-swap="outerHTML"
					class="inline-flex items-center ml-1"
				>
					<input
						type="text"
						name="reviewer"
						placeholder="+ reviewer or @group..."
						class="bg-slate-900 border border-slate-700/80 rounded px-2 py-0.5 text-[11px] font-mono text-slate-200 placeholder-slate-500 focus:outline-none focus:border-sky-500 w-36 focus:w-48 transition-all"
					/>
				</form>
			}
		</div>
	</div>
}

templ UnresolvedCommentsModal(data CLDetailData) {
	<dialog
		id="unresolved-comments-modal"
		class="backdrop:bg-black/75 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto rounded-2xl shadow-2xl border border-amber-700/60 max-w-xl w-full text-slate-200 overflow-hidden"
	>
		<div class="bg-[#0f172a] rounded-2xl border border-amber-700/60 overflow-hidden flex flex-col">
			<!-- Header -->
			<div class="px-6 py-4 bg-[#0c1322] border-b border-slate-800 flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<div class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 font-bold">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
						</svg>
					</div>
					<div>
						<h3 class="text-sm font-bold text-white font-mono">Submission Blocked: Unresolved Comments</h3>
						<p class="text-xs text-amber-400/80">CL cannot be submitted while comment threads remain open</p>
					</div>
				</div>
				<button
					type="button"
					onclick="document.getElementById('unresolved-comments-modal').close()"
					class="text-slate-400 hover:text-slate-100 p-1.5 rounded-lg hover:bg-slate-800 transition text-sm leading-none"
					title="Close dialog"
				>
					✕
				</button>
			</div>

			<!-- Body -->
			<div class="p-6 space-y-4 text-xs leading-relaxed text-slate-300">
				<p>
					Under the current repository review policy (<code class="text-amber-300 bg-amber-950/60 px-1.5 py-0.5 rounded font-mono">allow_submit_with_unresolved_comments = false</code>), all inline comment threads must be addressed and resolved before submitting to trunk.
				</p>

				<div class="p-3 bg-amber-950/30 border border-amber-800/40 rounded-lg flex items-center space-x-2 text-amber-200">
					<svg class="w-4 h-4 shrink-0 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
					</svg>
					<span>
						{ fmt.Sprintf("There %s %d unresolved comment thread%s currently open.", mapBool(data.UnresolvedComments == 1, "is", "are"), data.UnresolvedComments, pluralS(data.UnresolvedComments)) }
					</span>
				</div>

				<!-- Files with unresolved comments -->
				if data.UnresolvedComments > 0 {
					<div class="space-y-1.5">
						<span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 font-mono">Files with Pending Comments</span>
						<div class="divide-y divide-slate-800/60 border border-slate-800 rounded-lg overflow-hidden bg-slate-900/60">
							for _, file := range data.Files {
								if file.UnresolvedComments > 0 {
									<div class="px-3 py-2 flex items-center justify-between font-mono">
										<a
											href={ templ.SafeURL(fmt.Sprintf("/cl/%d/file/%s?ps=%d&base_ps=%d", data.CL.CLID, file.Path, data.CurrentPatchset, data.BasePatchset)) }
											class="text-slate-300 hover:text-sky-400 transition"
											onclick="document.getElementById('unresolved-comments-modal').close()"
										>
											{ file.Path }
										</a>
										<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-950 text-amber-300 border border-amber-800/50">
											<span>💬</span>
											<span>{ fmt.Sprintf("%d unresolved", file.UnresolvedComments) }</span>
										</span>
									</div>
								}
							}
						</div>
					</div>
				}
			</div>

			<!-- Footer Actions -->
			<div class="px-6 py-3 bg-[#0c1322] border-t border-slate-800 flex items-center justify-end space-x-2">
				<button
					type="button"
					onclick="document.getElementById('unresolved-comments-modal').close()"
					class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold transition"
				>
					Dismiss
				</button>
				<button
					type="button"
					onclick="document.getElementById('unresolved-comments-modal').close(); const el = document.querySelector('.diff-row-has-comment') || document.querySelector('table'); if (el) { el.scrollIntoView({behavior: 'smooth'}); }"
					class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-amber-600/20 transition flex items-center space-x-1.5 cursor-pointer"
				>
					<span>Review Comments</span>
				</button>
			</div>
		</div>
	</dialog>
}

templ OverrideApprovalsModal(data CLDetailData) {
	<dialog
		id="override-approvals-modal"
		class="backdrop:bg-black/75 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto rounded-2xl shadow-2xl border border-slate-700 max-w-lg w-full text-slate-200 overflow-hidden"
	>
		<div class="bg-[#0f172a] rounded-2xl border border-slate-700/60 overflow-hidden flex flex-col">
			<!-- Header -->
			<div class="px-6 py-4 bg-[#0c1322] border-b border-slate-800 flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<div class="w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 font-bold">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
						</svg>
					</div>
					<div>
						<h3 class="text-sm font-bold text-white font-mono">Override Approvals and Submit</h3>
						<p class="text-xs text-slate-400">
							{ fmt.Sprintf("Requires %d approval(s), currently has %d.", data.RequiredApprovals, data.ApprovedCount) }
						</p>
					</div>
				</div>
				<button
					type="button"
					onclick="document.getElementById('override-approvals-modal').close()"
					class="text-slate-400 hover:text-slate-100 p-1.5 rounded-lg hover:bg-slate-800 transition text-sm leading-none"
					title="Close dialog"
				>
					✕
				</button>
			</div>

			<!-- Body with form -->
			<form
				method="POST"
				action={ templ.SafeURL(fmt.Sprintf("/cl/%d/submit", data.CL.CLID)) }
				class="p-6 flex flex-col space-y-4 text-xs"
			>
				<p class="text-slate-300 leading-relaxed">
					This changelist has fewer approvals than required by repository policy. You may override approval requirements by providing a justification below.
				</p>

				<div class="flex flex-col space-y-1.5">
					<textarea
						id="override-justification-input"
						name="justification"
						rows="4"
						maxlength="400"
						placeholder="Enter approval override justification..."
						oninput="updateOverrideSubmitState()"
						onkeyup="updateOverrideSubmitState()"
						class="w-full bg-[#0a0f1d] border border-slate-700 rounded-xl p-3 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-500/80 focus:ring-1 focus:ring-amber-500/80 resize-none font-sans"
					></textarea>
					<div class="flex justify-end">
						<span id="override-char-counter" class="text-[11px] text-slate-400 font-mono">0 / 400</span>
					</div>
				</div>

				<div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-800">
					<button
						type="button"
						onclick="document.getElementById('override-approvals-modal').close()"
						class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition"
					>
						Cancel
					</button>
					<button
						type="submit"
						id="override-submit-btn"
						disabled
						class="px-4 py-1.5 bg-slate-800 text-slate-500 border border-slate-700/60 rounded-lg text-xs font-semibold cursor-not-allowed transition"
					>
						Submit
					</button>
				</div>
			</form>
		</div>
	</dialog>
	<script>
		function updateOverrideSubmitState() {
			const input = document.getElementById('override-justification-input');
			const counter = document.getElementById('override-char-counter');
			const btn = document.getElementById('override-submit-btn');
			if (!input || !counter || !btn) return;

			const len = input.value.length;
			counter.textContent = len + ' / 400';

			if (input.value.trim().length > 0 && len <= 400) {
				btn.disabled = false;
				btn.className = 'px-4 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-sky-600/30 cursor-pointer transition';
			} else {
				btn.disabled = true;
				btn.className = 'px-4 py-1.5 bg-slate-800 text-slate-500 border border-slate-700/60 rounded-lg text-xs font-semibold cursor-not-allowed transition';
			}
		}

		(function() {
			const modal = document.getElementById('override-approvals-modal');
			if (modal) {
				modal.addEventListener('close', function() {
					const input = document.getElementById('override-justification-input');
					if (input) {
						input.value = '';
						updateOverrideSubmitState();
					}
				});
			}
		})();
	</script>
}

templ StatusBadge(status string, isApproved bool) {
	if isApproved && status != "submitted" {
		<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950 text-emerald-400 border border-emerald-800 flex items-center space-x-1">
			<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
			<span>Approved</span>
		</span>
	} else {
		switch status {
			case "submitted":
				<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-950 text-sky-400 border border-sky-800">
					Submitted
				</span>
			case "shelved":
				<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-950 text-indigo-400 border border-indigo-800">
					Shelved
				</span>
			default:
				<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-950 text-amber-400 border border-amber-800">
					Under Review
				</span>
		}
	}
}

templ ApprovalButtons(clID int64, approvals []db.Approval) {
	<div class="flex items-center space-x-2">
		<button
			type="button"
			hx-post={ fmt.Sprintf("/cl/%d/approval?verdict=lgtm", clID) }
			hx-target="#cl-actions-bar"
			hx-swap="outerHTML"
			class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-emerald-600/20 transition flex items-center space-x-1.5 cursor-pointer"
		>
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
			<span>LGTM / Approve</span>
		</button>
		<button
			type="button"
			hx-post={ fmt.Sprintf("/cl/%d/approval?verdict=changes_requested", clID) }
			hx-target="#cl-actions-bar"
			hx-swap="outerHTML"
			class="px-3 py-1.5 bg-rose-900/60 hover:bg-rose-800 text-rose-200 border border-rose-700/60 rounded-lg text-xs font-semibold transition flex items-center space-x-1.5 cursor-pointer"
		>
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
			<span>Request Changes</span>
		</button>
	</div>
}

func isCLApproved(approvals []db.Approval) bool {
	hasLGTM := false
	for _, approval := range approvals {
		if approval.Verdict == "changes_requested" {
			return false
		}
		if approval.Verdict == "approved" || approval.Verdict == "lgtm" {
			hasLGTM = true
		}
	}
	return hasLGTM
}

func getVerdictClass(verdict string) string {
	switch verdict {
	case "approved", "lgtm":
		return "bg-emerald-950/80 text-emerald-300 border border-emerald-800/60"
	case "changes_requested":
		return "bg-rose-950/80 text-rose-300 border border-rose-800/60"
	default:
		return "bg-slate-800 text-slate-300 border border-slate-700"
	}
}

func pluralS(count int) string {
	if count == 1 {
		return ""
	}
	return "s"
}

templ FileReviewBadge(clID int64, filePath string, reviewed bool, currentPS int, basePS int) {
	<div
		id={ fmt.Sprintf("file-review-badge-%s", sanitizeHTMLID(filePath)) }
		class="inline-flex items-center justify-center"
	>
		<button
			type="button"
			hx-post={ fmt.Sprintf("/cl/%d/file-review?file=%s&reviewed=%t&ps=%d&base_ps=%d", clID, filePath, !reviewed, currentPS, basePS) }
			hx-target={ fmt.Sprintf("#file-review-badge-%s", sanitizeHTMLID(filePath)) }
			hx-swap="outerHTML"
			class="focus:outline-none cursor-pointer group"
			title={ fmt.Sprintf("Click to mark as %s", mapBool(reviewed, "not reviewed", "reviewed")) }
		>
			if reviewed {
				<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/50 shadow-sm shadow-emerald-950/40 group-hover:bg-emerald-900/40 transition">
					<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>reviewed</span>
				</span>
			} else {
				<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-800/80 text-slate-400 border border-slate-700/60 group-hover:text-slate-200 group-hover:border-slate-500 transition">
					<span class="w-1.5 h-1.5 rounded-full bg-slate-500 group-hover:bg-slate-300"></span>
					<span>not reviewed</span>
				</span>
			}
		</button>
	</div>
}

func mapBool(b bool, trueStr, falseStr string) string {
	if b {
		return trueStr
	}
	return falseStr
}

func sanitizeHTMLID(s string) string {
	res := strings.ReplaceAll(s, "/", "-")
	res = strings.ReplaceAll(res, ".", "-")
	res = strings.ReplaceAll(res, "_", "-")
	return res
}

templ CIRunnersBlock(data CLDetailData) {
	<div id="ci-runners-block" class="bg-[#080d1a] border-b border-slate-800 px-6 py-3">
		<div class="flex items-center justify-between mb-2">
			<div class="flex items-center space-x-2">
				<span class="flex items-center space-x-1.5 text-xs font-bold uppercase tracking-wider text-cyan-400">
					<svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
					</svg>
					<span>CI Runners</span>
				</span>
				<span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-cyan-950/80 text-cyan-300 border border-cyan-800/40">
					{ strconv.Itoa(len(data.CIRunners)) }
				</span>
			</div>
			if len(data.CIRunners) > 0 {
				<div class="flex items-center space-x-2 text-xs">
					@CIRunnerAggregateBadge(data.CIRunners)
				</div>
			}
		</div>

		if len(data.CIRunners) == 0 {
			<div class="py-4 text-center text-xs text-slate-500 font-mono bg-[#0c1222]/40 rounded-lg border border-slate-800/60">
				No CI runners assigned or required for this changelist.
			</div>
		} else {
			<div class="overflow-x-auto rounded-lg border border-slate-800/80 bg-[#0c1322]">
				<table class="w-full text-left font-mono text-xs">
					<thead class="bg-slate-900/80 text-slate-400 border-b border-slate-800 text-[11px] uppercase">
						<tr>
							<th class="w-28 px-3 py-2 text-center">Status</th>
							<th class="px-3 py-2">Runner Name / ID</th>
							<th class="w-32 px-3 py-2 text-center">Provider</th>
							<th class="w-32 px-3 py-2 text-right">Duration</th>
							<th class="w-36 px-3 py-2 text-center">Output</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-800/50">
						for _, runner := range data.CIRunners {
							<tr class="hover:bg-slate-800/50 transition">
								<td class="w-28 px-3 py-2 text-center">
									@CIRunnerStatusBadge(runner.Status)
								</td>
								<td class="px-3 py-2">
									<div class="flex items-center space-x-2">
										<span class="text-slate-200 font-semibold">{ runner.RunnerName }</span>
										if runner.IsRequired {
											<span class="px-1.5 py-0.5 rounded text-[10px] font-sans font-bold bg-indigo-950/80 text-indigo-300 border border-indigo-700/60" title="Required to pass before SubmitCL">
												Required
											</span>
										}
									</div>
								</td>
								<td class="w-32 px-3 py-2 text-center">
									<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300 border border-slate-700/60">
										{ runner.Provider }
									</span>
								</td>
								<td class="w-32 px-3 py-2 text-right font-mono text-[11px] text-slate-400">
									if runner.Duration != "" {
										<span>{ runner.Duration }</span>
									} else {
										<span class="text-slate-600">—</span>
									}
								</td>
								<td class="w-36 px-3 py-2 text-center">
									<div class="flex items-center justify-center space-x-2">
										if runner.LogBlobHex != "" {
											<a
												href={ templ.SafeURL(fmt.Sprintf("/cl/%d/raw?hash=%s", data.CL.CLID, runner.LogBlobHex)) }
												target="_blank"
												class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 hover:bg-slate-700 text-sky-400 hover:text-sky-300 border border-slate-700 transition"
												title="View CAS raw log output"
											>
												View Log ↗
											</a>
										}
										if runner.ExternalURL != "" {
											<a
												href={ templ.SafeURL(runner.ExternalURL) }
												target="_blank"
												rel="noopener noreferrer"
												class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition"
												title="Open external provider build"
											>
												External ↗
											</a>
										}
										if runner.LogBlobHex == "" && runner.ExternalURL == "" {
											<span class="text-slate-600 text-[10px]">—</span>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ CIRunnerStatusBadge(status string) {
	switch strings.ToLower(status) {
		case "passed":
			<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
				<span>✓</span>
				<span>Passed</span>
			</span>
		case "running":
			<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold bg-sky-500/10 text-sky-400 border border-sky-500/30">
				<span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
				<span>Running</span>
			</span>
		case "failed":
			<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/30">
				<span>✕</span>
				<span>Failed</span>
			</span>
		case "queued", "pending":
			<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
				<span>◷</span>
				<span>Queued</span>
			</span>
		case "skipped":
			<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-medium bg-slate-700/30 text-slate-400 border border-slate-600/30">
				<span>—</span>
				<span>Skipped</span>
			</span>
		case "canceled", "cancelled":
			<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-medium bg-zinc-700/30 text-zinc-400 border border-zinc-600/30">
				<span>⊘</span>
				<span>Canceled</span>
			</span>
		default:
			<span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
				<span>{ status }</span>
			</span>
	}
}

templ CIRunnerAggregateBadge(runners []CIRunnerItem) {
	{{
		passedCount := 0
		failedCount := 0
		runningCount := 0
		queuedCount := 0
		for _, runner := range runners {
			switch strings.ToLower(runner.Status) {
			case "passed":
				passedCount++
			case "failed":
				failedCount++
			case "running":
				runningCount++
			case "queued", "pending":
				queuedCount++
			}
		}
	}}
	if failedCount > 0 {
		<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-950/70 text-rose-400 border border-rose-800/40">
			{ fmt.Sprintf("%d Failed ✕", failedCount) }
		</span>
	} else if runningCount > 0 {
		<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-950/70 text-sky-400 border border-sky-800/40 animate-pulse">
			{ fmt.Sprintf("%d Running ●", runningCount) }
		</span>
	} else if queuedCount > 0 {
		<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-950/70 text-amber-300 border border-amber-800/40">
			{ fmt.Sprintf("%d Queued ◷", queuedCount) }
		</span>
	} else if passedCount == len(runners) && len(runners) > 0 {
		<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950/70 text-emerald-400 border border-emerald-800/40">
			All checks passed ✓
		</span>
	}
}

