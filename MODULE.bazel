# /monorepo/MODULE.bazel

# 1. Define your core monorepo identity and versioning metadata
module(
    name = "matatan_monorepo",
    version = "1.0.0",
)

# 2. Bring in core language rulesets from the Bazel Central Registry (BCR)
# These tell Bazel how to interpret, compile, and test specific languages
bazel_dep(name = "rules_python", version = "0.31.0")
bazel_dep(name = "rules_nodejs", version = "6.1.0")
bazel_dep(name = "rules_go", version = "0.46.0")
bazel_dep(name = "gazelle", version = "0.35.0")
bazel_dep(name = "aspect_rules_js", version = "1.40.0")

# 3. Bring in OCI (Docker) container rulesets
# This is what allows Bazel to natively build lightweight container images 
# that your Arion local stack can spin up!
bazel_dep(name = "rules_oci", version = "1.7.4")

# ==========================================
# 4. EXTENSIONS (For Language-Specific Package Managers)
# ==========================================
# For tools like pip or npm, Bazel uses "Module Extensions" to bridge ecosystems.

# Example: Bringing in standard pip packages for an AI/Python target
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

pip.parse(
    hub_name = "pip_deps",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock.txt", # Points to your lockfile
)

use_repo(pip, "pip_deps")

# Bringing in Go SDK and configuring dependencies from go.mod via Gazelle
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.21.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Expose specific Go dependencies generated by Gazelle from go.mod
# Example:
# use_repo(go_deps, "org_golang_google_grpc")

# Bringing in Node.js toolchain and translating package manager lockfile (pnpm-lock.yaml)
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "20.11.0")
use_repo(node, "nodejs_toolchains")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

